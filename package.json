    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/plugin-auth-node": "^0.7.6",
    "@backstage/types": "^1.2.2",
    "jose": "^5.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "configSchema": "config.d.ts"
